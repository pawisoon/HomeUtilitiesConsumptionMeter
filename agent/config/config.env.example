# /etc/home-utilities/config.env — settings shared by every meter.
# Keep this file readable by root only; it holds two secrets.

# Where the dashboard lives, and the token it expects from this machine.
# Leave both empty to store readings locally without publishing them.
PANEL_URL=https://utilities.example.workers.dev
PANEL_TOKEN=

# Daily Telegram summary. Leave the token empty to skip messaging entirely.
# Create a bot with @BotFather, then find the chat id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anything else that holds the SDR dongle. Each read stops these services and
# starts them again afterwards. Leave empty if the dongle is dedicated.
SDR_SHARED_SERVICES=""

# Used for the dates in the Telegram message.
TIME_ZONE=Europe/Warsaw
